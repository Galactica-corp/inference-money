{
	"name": "@galactica-net/inference-money-showcase",
	"version": "0.0.0",
	"private": true,
	"description": "The showcase: the demo cast moves USDC between Ethereum and Aztec with embedded wallets, and the rules refuse what they should.",
	"homepage": "https://privateinference.gg/",
	"bugs": {
		"url": "https://github.com/Galactica-corp/inference-money/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Galactica-corp/inference-money.git",
		"directory": "apps/showcase"
	},
	"license": "Apache-2.0",
	"author": "Galactica Network",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"build:testnet": "BRIDGE_TARGET=testnet vite build && BUILT_TARGET=testnet BUILT_DIST=dist vitest run build/manifest-identity.test.ts build/bundle.test.ts",
		"deploy": "wrangler deploy",
		"deploy:preview": "wrangler versions upload",
		"dev": "vite",
		"preview": "vite preview",
		"test": "vitest run",
		"test:components": "vitest run",
		"test:e2e": "bash e2e/agent.sh",
		"test:e2e:presto": "bash e2e/presto.sh",
		"test:proving": "bash e2e/proving.sh",
		"test:testnet": "playwright test --config e2e/playwright.testnet.config.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit -p e2e/run/tsconfig.json"
	},
	"dependencies": {
		"@alejoamiras/presto": "6.0.0-rc.3",
		"@alejoamiras/presto-banners": "1.2.0",
		"@aztec-labs/aztec.js": "6.0.0-rc.3",
		"@aztec-labs/pxe": "6.0.0-rc.3",
		"@aztec-labs/simulator": "6.0.0-rc.3",
		"@aztec-labs/stdlib": "6.0.0-rc.3",
		"@aztec-labs/wallets": "6.0.0-rc.3",
		"@fontsource-variable/archivo": "5.3.0",
		"@fontsource-variable/bricolage-grotesque": "5.3.0",
		"@fontsource-variable/figtree": "5.3.0",
		"@fontsource/ibm-plex-mono": "5.3.0",
		"@fontsource/ibm-plex-sans": "5.3.0",
		"@galactica-net/inference-money-core": "workspace:*",
		"@galactica-net/inference-money-demo": "workspace:*",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"viem": "2.56.7",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@galactica-net/inference-money-deployer": "workspace:*",
		"@galactica-net/inference-money-local-network": "workspace:*",
		"@playwright/test": "1.63.0",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/bun": "1.4.2",
		"@types/node": "26.6.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"jsdom": "30.1.0",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.0",
		"vite-plugin-node-polyfills": "0.28.0",
		"vitest": "5.0.1"
	}
}
